<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.aimediasorter.app.debug" />
        <package android:name="com.aimediasorter.app" />
    </queries>
    <application>
        <activity android:name="com.aimediasorter.app.FixtureGrantActivity"
            android:exported="true" android:theme="@android:style/Theme.NoDisplay" />
        <!-- Present only in the instrumentation APK, never in the distributable app. -->
        <provider android:name="com.aimediasorter.app.FixtureDocumentsProvider"
            android:authorities="com.aimediasorter.app.qa.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
